{
  "name": "Zebotix — Empowering innovation with software & AI",
  "short_name": "Zebotix",
  "description": "Zebotix — software & AI solutions that power modern businesses: web apps, ML, and custom IT services. Build responsive web apps, AI-driven products, and scalable systems with our expert team.",
  "start_url": "/",
  "theme_color": "#1d1d1d",
  "background_color": "#1d1d1d",
  "display": "standalone",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en-US",
  "categories": ["business", "technology", "software", "AI", "web development"],
  "dir": "ltr",
  "prefer_related_applications": false,
  "screenshots": [],
  "iarc_rating_id": "e.g. 123456",
  "iarc_sandbox_id": "e.g. 123456",
  "gcm_sender_id": "e.g. 1234567890",
  "gcm_user_visible_only": true,
  "serviceworker": {
    "src": "/sw.js",
    "scope": "/",
    "type": "classic",
    "update_via_cache": "none"
  },
  "protocol_handlers": [
    {
      "protocol": "mailto",
      "url": "/compose?to=%s"
    },
    {
      "protocol": "web+zebotix",
      "url": "/?url=%s"
    }
  ],
  "shortcuts": [
    {
      "name": "Home",
      "short_name": "Home",
      "url": "/",
      "icons": [
        {
          "src": "../Zebotix.webp",
          "sizes": "192x192",
          "type": "image/webp"
        }
      ]
    }
  ],
  "custom_shortcuts": [
    {
      "name": "Contact",
      "short_name": "Contact",
      "url": "/contact",
      "icons": [
        {
          "src": "../Zebotix.webp",
          "sizes": "192x192",
          "type": "image/webp"
        }
      ]
    }
  ],
  "related_applications": [
    {
      "platform": "web",
      "url": "/",
      "id": "com.zebotix.web"
    }
  ],
  "icons": [
    {
      "src": "../Zebotix.webp",
      "sizes": "32x32",
      "type": "image/webp"
    },
    {
      "src": "../Zebotix.webp",
      "sizes": "180x180",
      "type": "image/webp"
    },
    {
      "src": "../Zebotix.webp",
      "sizes": "192x192",
      "type": "image/webp"
    },
    {
      "src": "../Zebotix.webp",
      "sizes": "512x512",
      "type": "image/webp"
    }
  ],
  "maskable_icon": true,
  "apple": {
    "status_bar_style": "black-translucent",
    "web_app_capable": "yes",
    "web_app_title": "Zebotix"
  },
  "ms": {
    "tile_color": "#1d1d1d",
    "tile_image": "../Zebotix.webp",
    "config": ""
  },
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "video/*"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/file-handler",
      "accept": {
        "image/*": [".png", ".jpg", ".jpeg", ".gif", ".webp"],
        "text/*": [".txt", ".md", ".json", ".xml"],
        "application/pdf": [".pdf"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "display_override": ["standalone", "fullscreen"],
  "description_short": "Software & AI solutions for modern businesses.",
  "description_long": "Zebotix is a Karachi-based digital studio specializing in software and AI solutions that empower modern businesses. We offer a range of services including web application development, machine learning integration, and custom IT solutions. Our expert team is dedicated to building responsive web apps, AI-driven products, and scalable systems that meet the unique needs of our clients. Partner with us to transform your business with cutting-edge technology and innovative solutions.",
  "developer": {
    "name": "Muhammad Zeeshan Khan",
    "url": "https://mzeeshankhan.netlify.app"
  },
  "version": "1.0.0",
  "build_date": "2024-10-01T00:00:00Z",
  "last_updated": "2024-10-01T00:00:00Z",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zebotix/zebotix",
    "branch": "main"
  },
  "license": "MIT",
  "keywords": [
    "Zebotix",
    "software",
    "AI",
    "web development",
    "machine learning",
    "digital studio",
    "Karachi"
  ],
  "privacy_policy": "/privacy",
  "terms_of_service": "/terms",
  "support": {
    "email": "zebotix@gmail.com",
    "url": "/contact"
  },
  "contact": {
    "email": "zebotix@gmail.com",
    "url": "/contact"
  },
  "social": {
    "twitter": "https://x.com/zebotix1499",
